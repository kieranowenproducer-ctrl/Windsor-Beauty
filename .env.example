
# Host retirement preparation: unset/legacy preserves all current behaviour.
# public opens canonical .is only; closed holds all shops for rollback.
# Both modes retire old/unknown public shops. No activation without exact approval.
WINDSOR_STOREFRONT_MODE=
# Comma-separated EXACT registered machine hosts only, after private provider inventory.
# Adds only existing webhook/cron ingress; never opens shop/account/payment pages.
WINDSOR_COMPATIBILITY_HOSTS=
